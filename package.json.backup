{
  "cds": {
    "requires": {
      "SCP_API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/SCP_API_BUSINESS_PARTNER"
      }
    }
  },
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/odata-v2": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^6.8.2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap-cloud-sdk/generator": "^4.8.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "watch-supplierportal": "cds watch --open supplier.po.supplierportal/index.html?sap-ui-xx-viewCache=false --livereload false"
  }
}
