{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/bp/(.*)$",
      "target": "/bp/$1",
      "destination": "BP_CAP_API",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}